{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/kino/.config/fastfetch/rose.txt",
    "color": { "1": "red", "2": "green" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "magenta" }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m╭─────────────── \u001b[1;35mkino\u001b[0m\u001b[90m ───────────────╮"
    },
    { "type": "os",     "key": "\u001b[90m│\u001b[0m  Distro ", "keyColor": "cyan" },
    { "type": "wm",     "key": "\u001b[90m│\u001b[0m  WM     ", "keyColor": "cyan" },
    { "type": "de",     "key": "\u001b[90m│\u001b[0m  DE     ", "keyColor": "cyan" },
    { "type": "memory", "key": "\u001b[90m│\u001b[0m  RAM    ", "keyColor": "cyan" },
    { "type": "uptime", "key": "\u001b[90m│\u001b[0m  Boot   ", "keyColor": "cyan" },
    {
      "type": "command",
      "key": "\u001b[90m│\u001b[0m  Total  ",
      "keyColor": "cyan",
      "text": "~/.config/fastfetch/total-hours.sh"
    },
    {
      "type": "custom",
      "format": "\u001b[90m╰────────────────────────────────────╯"
    },
    { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
  ]
}
